<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" alignment="CENTER" prefHeight="768" prefWidth="1024" spacing="12" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.game_farmfrenzy2.view.GameView">

    <padding>
        <Insets bottom="16" left="20" right="20" top="16" />
    </padding>

    <HBox alignment="CENTER" spacing="30" style="-fx-background-color: rgba(0,0,0,0.45); -fx-background-radius: 12; -fx-padding: 10 20;">
        <Label fx:id="coinLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f1c40f;" text="Coins: 20" />
        <Label fx:id="timeLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Time: 90s" />
        <Label fx:id="targetLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2ecc71;" text="Chickens: 1/2" />
    </HBox>

    <GridPane fx:id="gridPane" alignment="CENTER" hgap="3" vgap="3" />

    <HBox alignment="CENTER" spacing="14" style="-fx-background-color: rgba(0,0,0,0.45); -fx-background-radius: 12; -fx-padding: 12 16;">
        <Button onAction="#onBuyChicken" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Buy Chicken (20)" />
        <Button onAction="#onBuyDog" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8;" text="Buy Dog (100)" />
        <Button onAction="#onBuyCat" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8;" text="Buy Cat (80)" />
        <Button onAction="#onBuyCow" style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Buy Cow (50)" />
        <Button onAction="#onBuyOstrich" style="-fx-background-color: #16a085; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Buy Ostrich (40)" />
    </HBox>
   <HBox alignment="CENTER" layoutX="30.0" layoutY="404.0" spacing="14" style="-fx-background-color: rgba(0,0,0,0.45); -fx-background-radius: 12; -fx-padding: 12 16;">
      <children>
         <Button onAction="#onShop" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Shop" />
         <Button onAction="#onAirplane" style="-fx-background-color: #1abc9c; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Airplane" />
         <Button onAction="#onSettings" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Settings" />
         <Button onAction="#onWarehouse" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Warehouse" />
         <Button onAction="#onMenu" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Menu" />
      </children>
   </HBox>
</VBox>
