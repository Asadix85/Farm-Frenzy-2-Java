<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.game_farmfrenzy2.view.AirplaneView"
           prefWidth="1024" prefHeight="768">

    <VBox alignment="CENTER" spacing="18" maxWidth="580"
          style="-fx-background-color: rgba(30, 50, 40, 0.88); -fx-background-radius: 22; -fx-padding: 40 50 40 50; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 20, 0.3, 0, 8);">

        <Label text="AIRPLANE ORDER"
               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #f1c40f;"/>

        <HBox spacing="12" alignment="CENTER"
              style="-fx-background-color: rgba(0,0,0,0.25); -fx-background-radius: 10; -fx-padding: 12 20;">
            <Label text="Coins:"
                   style="-fx-text-fill: white; -fx-font-size: 16px;"/>
            <Label fx:id="coinLabel" text="0"
                   style="-fx-text-fill: #f1c40f; -fx-font-size: 20px; -fx-font-weight: bold;"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER">
            <ComboBox fx:id="productCombo" prefWidth="200" prefHeight="38"
                      style="-fx-background-color: #ecf0f1; -fx-background-radius: 8;"/>
            <TextField fx:id="quantityField" promptText="Qty" prefWidth="90" prefHeight="38"
                       style="-fx-background-color: #ecf0f1; -fx-background-radius: 8; -fx-font-size: 14px;"/>
            <Button onAction="#onAddOrder" text="Add Order" prefHeight="38"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 0 16;"/>
        </HBox>

        <ListView fx:id="orderList" prefHeight="220" prefWidth="460"
                  style="-fx-background-color: rgba(44, 62, 80, 0.9); -fx-control-inner-background: #2c3e50; -fx-background-radius: 10; -fx-border-color: #1abc9c; -fx-border-radius: 10; -fx-border-width: 1.5;"/>

        <Label fx:id="statusLabel" text=""
               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #ecf0f1;"/>

        <HBox spacing="16" alignment="CENTER">
            <Button onAction="#onSend" text="Send Airplane" prefWidth="170" prefHeight="44"
                    style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;"/>
            <Button onAction="#onBack" text="Back to Game" prefWidth="170" prefHeight="44"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</StackPane>