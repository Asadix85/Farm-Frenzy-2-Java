<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="root" prefHeight="768" prefWidth="1024" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.game_farmfrenzy2.view.MissionView">

    <VBox alignment="CENTER" maxWidth="560" spacing="18" style="-fx-background-color: rgba(50, 40, 40, 0.80); -fx-background-radius: 22; -fx-padding: 42 50 42 50; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 20, 0.3, 0, 8);">

        <Label style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #f1c40f;" text="MISSION" />

        <Label fx:id="levelLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" text="Level 1" />

        <Label fx:id="goalLabel" maxWidth="460" style="-fx-text-alignment: center; -fx-wrap-text: true;" text="" textAlignment="CENTER" textFill="WHITE" wrapText="true">
         <font>
            <Font size="16.0" />
         </font></Label>

        <Label fx:id="timeLabel" text="" textAlignment="CENTER" textFill="#1cb900">
         <font>
            <Font name="System Bold" size="15.0" />
         </font></Label>

        <Label fx:id="hintLabel" maxWidth="460" style="-fx-text-alignment: center; -fx-wrap-text: true;" text="" textAlignment="CENTER" textFill="#ffe868" wrapText="true">
         <font>
            <Font size="14.0" />
         </font></Label>

        <HBox alignment="CENTER" spacing="16">
            <Button onAction="#onStart" prefHeight="44" prefWidth="170" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="Start Mission" />
            <Button onAction="#onBack" prefHeight="44" prefWidth="140" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="Back" />
        </HBox>
    </VBox>
</StackPane>
