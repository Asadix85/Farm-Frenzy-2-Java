<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="768" prefWidth="1024" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.game_farmfrenzy2.view.LoginView">
    <VBox alignment="CENTER" maxWidth="420" spacing="18" style="-fx-background-color: rgba(30, 50, 40, 0.82); -fx-background-radius: 20; -fx-padding: 40 50 40 50; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 18, 0.3, 0, 6);">

        <Label style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #f1c40f;" text="FARM FRENZY 2" />

        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" text="LOGIN" />

        <TextField fx:id="usernameField" prefHeight="40" prefWidth="300" promptText="Username" style="-fx-background-color: #ecf0f1; -fx-background-radius: 8; -fx-font-size: 14px; -fx-padding: 8 12;" />

        <PasswordField fx:id="passwordField" prefHeight="40" prefWidth="300" promptText="Password" style="-fx-background-color: #ecf0f1; -fx-background-radius: 8; -fx-font-size: 14px; -fx-padding: 8 12;" />

        <Label fx:id="errorLabel" style="-fx-text-fill: #e74c3c; -fx-font-size: 13px; -fx-font-weight: bold;" text="" />

        <HBox alignment="CENTER" spacing="16">
            <Button onAction="#onLogin" prefHeight="42" prefWidth="130" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="Login" />
            <Button onAction="#onRegister" prefHeight="42" prefWidth="130" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="Register" />
        </HBox>
    </VBox>
</StackPane>
