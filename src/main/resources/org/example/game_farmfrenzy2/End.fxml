<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="root" prefHeight="768" prefWidth="1024" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.game_farmfrenzy2.view.EndView">

    <VBox alignment="CENTER" maxWidth="520" spacing="22" style="-fx-background-color: rgba(30, 50, 40, 0.88); -fx-background-radius: 22; -fx-padding: 45 55 45 55; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 20, 0.3, 0, 8);">
      <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../images/game/Icon.png" />
         </image>
      </ImageView>

        <Label fx:id="resultLabel" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #f1c40f;" text="" />

        <HBox alignment="CENTER" spacing="24">
            <Text fx:id="star1" style="-fx-font-size: 48px; -fx-fill: #f1c40f;" text="☆" />
            <Text fx:id="star2" style="-fx-font-size: 48px; -fx-fill: #f1c40f;" text="☆" />
            <Text fx:id="star3" style="-fx-font-size: 48px; -fx-fill: #f1c40f;" text="☆" />
        </HBox>

        <Label fx:id="messageLabel" style="-fx-font-size: 16px; -fx-text-fill: #ecf0f1; -fx-text-alignment: center;" text="" />

        <Label fx:id="coinsLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f39c12;" text="" />

        <Label fx:id="timeLabel" style="-fx-font-size: 16px; -fx-text-fill: #bdc3c7;" text="" />

        <HBox alignment="CENTER" spacing="16">
            <Button fx:id="nextButton" onAction="#onNext" prefHeight="44" prefWidth="140" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="Next Level" />
            <Button onAction="#onRetry" prefHeight="44" prefWidth="140" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="Retry" />
            <Button onAction="#onMenu" prefHeight="44" prefWidth="140" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="Main Menu" />
        </HBox>
    </VBox>
</StackPane>
